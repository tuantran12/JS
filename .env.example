# ==========================================
# SENKAI Platform Environment Variables
# ==========================================

# App Configuration
NEXT_PUBLIC_APP_URL=https://senkai.xyz
NEXT_PUBLIC_APP_NAME=SENKAI

# Solana Configuration
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Alternative: https://solana-api.projectserum.com
# For devnet: https://api.devnet.solana.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Hugging Face AI Configuration
HUGGINGFACE_API_KEY=hf_your_api_key_here
NEXT_PUBLIC_AI_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Solana Pay Configuration
NEXT_PUBLIC_SENKAI_TOKEN_MINT=your_spl_token_mint_address
NEXT_PUBLIC_MERCHANT_WALLET=your_merchant_wallet_address

# CoinGecko API (for market data)
NEXT_PUBLIC_COINGECKO_API_KEY=your_coingecko_api_key
# Free tier: https://www.coingecko.com/en/api/pricing

# CoinMarketCap API (for market data - alternative)
NEXT_PUBLIC_COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
# Free tier: https://coinmarketcap.com/api/pricing/

# Jupiter Aggregator (for trading)
NEXT_PUBLIC_JUPITER_API_URL=https://quote-api.jup.ag/v6

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@senkai.xyz

# Security
JWT_SECRET=your_very_long_random_jwt_secret_here_minimum_32_characters
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://senkai.xyz

# Rate Limiting (Optional)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Feature Flags (Optional)
NEXT_PUBLIC_ENABLE_COPY_TRADING=true
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_REFERRALS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Development/Debug Settings
NODE_ENV=production
NEXT_PUBLIC_DEBUG_MODE=false
