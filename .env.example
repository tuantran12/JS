# ==========================================
# BLOWFI Platform - Frontend Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values

# ==========================================
# Privy Authentication (REQUIRED)
# ==========================================
# Get your App ID from: https://dashboard.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# ==========================================
# Backend API (Optional)
# ==========================================
# URL for Express.js backend API
# If not set, will default to same domain (for monorepo deployments)
# Example: https://api.yourdomain.com or http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=

# ==========================================
# Solana RPC (Optional)
# ==========================================
# Solana RPC endpoint for blockchain interactions
# Defaults to public mainnet-beta if not set
# For production, use a dedicated RPC like Helius, Alchemy, or QuickNode
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Alternative RPC endpoints:
# Helius: https://rpc.helius.xyz/?api-key=YOUR_API_KEY
# Alchemy: https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# QuickNode: https://YOUR_ENDPOINT.solana-mainnet.quiknode.pro/YOUR_TOKEN/

# ==========================================
# Optional: Analytics & Monitoring
# ==========================================
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ==========================================
# Development Settings
# ==========================================
# NODE_ENV=production
# NEXT_PUBLIC_DEBUG_MODE=false
