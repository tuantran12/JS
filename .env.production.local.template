# ==========================================
# SENKAI PLATFORM - PRODUCTION ENVIRONMENT
# ==========================================
# This file contains ALL environment variables needed for production deployment
# Copy this file to .env.production.local and fill in the actual values
# NEVER commit .env.production.local to git!

# ==========================================
# 🔐 CRITICAL - AUTHENTICATION
# ==========================================

# Privy Authentication (Email + Embedded Wallets)
NEXT_PUBLIC_PRIVY_APP_ID=cmjmrxm39022pl10ct4kdn95w
PRIVY_APP_ID=cmjmrxm39022pl10ct4kdn95w
# Get from: https://dashboard.privy.io/
# Allowed origins must include: https://senkai.xyz

# ==========================================
# 🌐 APPLICATION CONFIGURATION
# ==========================================

NEXT_PUBLIC_APP_URL=https://senkai.xyz
NEXT_PUBLIC_APP_NAME=SENKAI
NODE_ENV=production

# ==========================================
# 🗄️ DATABASE - SUPABASE
# ==========================================

# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# ⛓️ BLOCKCHAIN - SOLANA
# ==========================================

# Mainnet RPC (Free tier)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# For better performance, use paid RPC:
# NEXT_PUBLIC_SOLANA_RPC_URL=https://your-rpc-provider.com/api-key
# Options: Helius, QuickNode, Alchemy, Triton

# Solana Pay & Token (Optional)
NEXT_PUBLIC_SENKAI_TOKEN_MINT=your_spl_token_mint_address_here
NEXT_PUBLIC_MERCHANT_WALLET=your_merchant_wallet_address_here

# ==========================================
# 💳 PAYMENT PROCESSING - STRIPE
# ==========================================

# Get from: https://dashboard.stripe.com/apikeys
# NOTE: These are TEST keys by default. Replace with LIVE keys for production!

STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Webhook Secret (Create at: https://dashboard.stripe.com/webhooks)
# Endpoint: https://senkai.xyz/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==========================================
# 🤖 AI SERVICES - HUGGING FACE
# ==========================================

# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here
NEXT_PUBLIC_AI_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Alternative models:
# - meta-llama/Llama-2-7b-chat-hf
# - microsoft/phi-2
# - google/flan-t5-xxl

# ==========================================
# 📊 MARKET DATA APIS
# ==========================================

# CoinGecko API (Optional - free tier has no key)
# Get Pro API from: https://www.coingecko.com/en/api/pricing
NEXT_PUBLIC_COINGECKO_API_KEY=CG-your_coingecko_api_key_here

# CoinMarketCap API (Optional - alternative to CoinGecko)
# Get from: https://coinmarketcap.com/api/pricing/
NEXT_PUBLIC_COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
# OR (both work):
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# ==========================================
# 🔒 SECURITY & AUTHENTICATION
# ==========================================

# Generate strong random strings (32+ characters)
# Example: openssl rand -base64 32
JWT_SECRET=your_very_long_random_jwt_secret_minimum_32_characters_here
NEXTAUTH_SECRET=your_nextauth_secret_at_least_32_characters_long_here
NEXTAUTH_URL=https://senkai.xyz

# ==========================================
# 📧 EMAIL CONFIGURATION (Optional)
# ==========================================

# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=noreply@senkai.xyz

# Alternative SMTP providers:
# - SendGrid: smtp.sendgrid.net
# - Mailgun: smtp.mailgun.org
# - AWS SES: email-smtp.us-east-1.amazonaws.com

# ==========================================
# 📈 ANALYTICS & MONITORING (Optional)
# ==========================================

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ==========================================
# ⚙️ FEATURE FLAGS
# ==========================================

NEXT_PUBLIC_ENABLE_COPY_TRADING=true
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_REFERRALS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_DEBUG_MODE=false

# ==========================================
# 🛡️ RATE LIMITING (Optional)
# ==========================================

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ==========================================
# 🚀 VERCEL-SPECIFIC (Auto-configured)
# ==========================================

# These are automatically set by Vercel, but you can override:
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=senkai.xyz
# VERCEL_REGION=iad1

# ==========================================
# 📝 NOTES
# ==========================================

# REQUIRED (Application won't work without these):
# - NEXT_PUBLIC_PRIVY_APP_ID
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
# - NEXT_PUBLIC_SOLANA_RPC_URL

# IMPORTANT (For full features):
# - STRIPE_SECRET_KEY (for payments)
# - HUGGINGFACE_API_KEY (for AI chat)
# - JWT_SECRET (for authentication)

# OPTIONAL (App works without, but limited):
# - CoinGecko/CoinMarketCap API keys (falls back to public APIs)
# - Email config (for notifications)
# - Analytics (for tracking)

# DEPRECATED/NOT NEEDED:
# - FRONTEND_URL (redundant)
# - NEXT_PUBLIC_BACKEND_URL (using Next.js API routes)

