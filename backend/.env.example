# Database (PostgreSQL for production, SQLite for dev)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Security
JWT_SECRET=your-32-char-secret-here-change-this

# Frontend URL (Vercel auto-populates VERCEL_URL)
FRONTEND_URL=https://your-frontend.vercel.app

# Privy Server SDK (REQUIRED)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# Platform Configuration
DAILY_COPY_DLOW=400
DAILY_SIM_DLOW=500
COPY_TX_FEE_SOL=0.002

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PLATFORM_WALLET_PRIVATE_KEY=your-wallet-private-key-base58

# External APIs
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key
