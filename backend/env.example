# Database
DATABASE_URL="file:./dev.db"

# Security
JWT_SECRET=your-32-char-secret-here

# URLs (use environment variables in production)
FRONTEND_URL=${FRONTEND_URL}

# Privy Server SDK (REQUIRED for auto-trading)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# Treasury wallet for fees
TREASURY_WALLET=ASQUKGPrqMRhwERRzMrutXJCo5qNdQMVM2BDU4NuZrvF

# Copy Trading DLOW fees (daily)
DAILY_SIM_DLOW=500
DAILY_LIVE_DLOW=250

# Platform fee per transaction
